# ============================================================
# TextShield configuration
# Copy this file to `.env` and adjust values as needed.
# Never commit a real .env file with actual API keys.
# ============================================================

# --- Application ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TITLE=TextShield

# --- Database ---
DATABASE_URL=sqlite:///./textshield.db

# Store a short (truncated) preview of analyzed messages in history.
# Default is false: only a SHA-256 hash is stored to protect user content.
HISTORY_STORE_PREVIEW=false
HISTORY_PREVIEW_LENGTH=120

# --- Validation ---
MAX_MESSAGE_LENGTH=10000

# --- ML model ---
MODEL_PATH=models/spam_classifier.joblib
VECTORIZER_PATH=models/tfidf_vectorizer.joblib
MODEL_METADATA_PATH=models/model_metadata.json
MODEL_METRICS_PATH=models/evaluation_report.json

# --- RAG / vector database ---
VECTOR_DB_PATH=vector_db
RAG_TOP_K=4

# Embedding provider: sentence_transformers | hashing
#  - sentence_transformers uses a local transformer model (recommended)
#  - hashing uses a deterministic char n-gram hash embedding (zero dependencies)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- LLM ---
# Providers: ollama | openai | nvidia | none
#   ollama : local Ollama server (https://ollama.com) -> LLM_BASE_URL=http://localhost:11434
#   openai : any OpenAI-compatible API -> LLM_BASE_URL=https://api.openai.com/v1
#   nvidia : NVIDIA NIM endpoint -> LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   none   : disable LLM, template-based explanations only
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30