# TextShield v2.2 — Example environment (copy to .env, fill secrets)
# Every variable below maps to app/core/settings.py Settings.* with validation on startup.
# Secrets support *_FILE (Docker secret file) e.g. JWT_SECRET_KEY_FILE=/run/secrets/jwt

# ------------------------------------------------------------------ App & Env
# ENVIRONMENT reads from APP_ENV env var (canonical attribute is ENVIRONMENT; APP_ENV alias kept for compat)
APP_ENV=development          # development | staging | production | test
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TITLE=TextShield
DATABASE_URL=sqlite:///./textshield.db
CONFIG_VERSION=2.2.0
LOG_FORMAT=text              # text | json (json = structured logs)

# ------------------------------------------------------------------ Security / Auth
# API_KEY optional in dev, required if you enforce auth in production
API_KEY=
# API_KEY_FILE=/run/secrets/api_key
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
JWT_SECRET_KEY=change-me-in-production-please-rotate
# JWT_SECRET_KEY_FILE=/run/secrets/jwt
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ------------------------------------------------------------------ History
HISTORY_STORE_PREVIEW=false
HISTORY_PREVIEW_LENGTH=120
MAX_MESSAGE_LENGTH=10000

# ------------------------------------------------------------------ Paths
MODEL_PATH=models/spam_classifier.joblib
VECTORIZER_PATH=models/tfidf_vectorizer.joblib
MODEL_METADATA_PATH=models/model_metadata.json
MODEL_METRICS_PATH=models/evaluation_report.json
VECTOR_DB_PATH=vector_db

# ------------------------------------------------------------------ RAG
RAG_TOP_K=4
RAG_MAX_CONTEXT_CHUNKS=5
RAG_MAX_TOKEN_LIMIT=2000
RAG_SIMILARITY_THRESHOLD=0.35
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ------------------------------------------------------------------ Semantic Engine (Phase 5)
SEMANTIC_ENABLED=true
SEMANTIC_EMBEDDING_MODEL=all-MiniLM-L6-v2
SEMANTIC_EMBEDDING_DIMENSION=384
SEMANTIC_CACHE_SIZE=512
SEMANTIC_BATCH_SIZE=16
SEMANTIC_DEVICE=auto            # auto | cpu | cuda
SEMANTIC_LANGUAGE_DETECTION=auto

# ------------------------------------------------------------------ Intent Engine (Phase 6)
INTENT_ENABLED=true
INTENT_CONFIDENCE_THRESHOLD=0.35
INTENT_BEHAVIOR_THRESHOLD=0.30
INTENT_URGENCY_THRESHOLD=0.30
INTENT_MAX_INTENTS=4

# ------------------------------------------------------------------ LLM
LLM_PROVIDER=ollama             # ollama | openai | nvidia | none
LLM_MODEL=
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
# LLM_API_KEY_FILE=/run/secrets/llm_key
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2

# ------------------------------------------------------------------ Risk Engine (informational scores)
RISK_SPAM_BASE=50.0
RISK_HAM_BASE=5.0
RISK_INDICATOR_HIGH_WEIGHT=12.0
RISK_INDICATOR_MEDIUM_WEIGHT=7.0
RISK_INDICATOR_LOW_WEIGHT=3.0
RISK_URL_HIGH_PATTERN=10.0
RISK_URL_SUSPICIOUS=6.0
RISK_URL_SHORTENER=4.0
RISK_HIGH_CONF_BONUS=15.0
RISK_RAG_CATEGORY_BONUS=8.0
RISK_INTENT_MALICIOUS=12.0
RISK_MEDIUM_THRESHOLD=30.0
RISK_HIGH_THRESHOLD=60.0
RISK_CRITICAL_THRESHOLD=80.0
RISK_CRITICAL_CONFIDENCE=0.85
RISK_UNCERTAIN_CONFIDENCE=0.5

# ------------------------------------------------------------------ Feature Flags
FEATURE_RAG=true
FEATURE_LLM=true
FEATURE_HISTORY=true

# ------------------------------------------------------------------ Removed / Deprecated
# None in v2.2 — see docs/MIGRATION_GUIDE.md and docs/Configuration.md for renames:
#   APP_ENV (attribute) -> ENVIRONMENT (env var remains APP_ENV for compat, alias provided)
