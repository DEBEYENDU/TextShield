# TextShield V2.2 — example env (copy to .env, fill secrets)
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./textshield.db
# Secrets: set directly or via *_FILE pointing to Docker secret file
API_KEY=
# API_KEY_FILE=/run/secrets/api_key
LLM_API_KEY=
# LLM_API_KEY_FILE=/run/secrets/llm_key
LLM_PROVIDER=ollama
LLM_MODEL=
LLM_BASE_URL=http://localhost:11434
MAX_MESSAGE_LENGTH=10000
RAG_TOP_K=4
LOG_FORMAT=text
CONFIG_VERSION=2.2
